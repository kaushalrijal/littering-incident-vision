# =============================================================================
# Real-Time Littering Detection System — configuration template
# =============================================================================
# Copy this file to `.env` in the project root and edit the values you need:
#
#     cp .env.example .env
#
# Every line below shows the built-in default, so an unedited copy behaves
# exactly like running with no `.env` at all. Delete or comment out (with `#`)
# any line to fall back to that default. All values are read by
# backend/app/config.py at startup.
# =============================================================================


# --- Paths -------------------------------------------------------------------
# SQLite database file (created automatically, WAL mode).
DATABASE_PATH=backend/data/litter.db
# Root folder for uploaded videos, snapshots, clips and annotated output.
STORAGE_DIR=backend/storage


# --- Server ------------------------------------------------------------------
# Interface and port for the FastAPI/uvicorn server.
HOST=127.0.0.1
PORT=8000
# Largest upload accepted, in megabytes.
MAX_UPLOAD_MB=500


# --- Model -------------------------------------------------------------------
# Ultralytics weights: a bundled name (yolov8n.pt) or a path to your own file.
# Use yolov8s.pt for more accuracy, or a fine-tuned model (for example a TACO
# model at ml/models/taco.pt).
MODEL_PATH=yolov8n.pt
# Inference device: cpu, 0 (first CUDA GPU), or mps (Apple Silicon).
DEVICE=cpu
# Detection confidence threshold (0.0–1.0). Lower catches more, but noisier.
CONF_THRESHOLD=0.30
# Non-maximum-suppression IoU threshold (0.0–1.0).
IOU_THRESHOLD=0.45
# Inference image size (pixels, square).
IMGSZ=640
# Classes treated as waste, matched against the model's own class names.
# For a fine-tuned model, for example: bottle,cup,wrapper,paper,other_waste
WASTE_CLASSES=bottle,cup


# --- Processing --------------------------------------------------------------
# Analyse every Nth frame (1 = every frame, 2 = every other frame, ...).
FRAME_STEP=2
# Maximum incidents recorded per video (a safety cap).
MAX_INCIDENTS=50
# Write an annotated output video (boxes, track IDs, HUD) for each processed
# video. Set to false to save disk space and time.
SAVE_OUTPUT_VIDEO=true
# Log every detection to the console (very verbose; for debugging only).
LOG_DETECTIONS=false
# Refuse videos longer than this many seconds (0 = no limit).
MAX_VIDEO_DURATION_S=0


# --- Event rule engine (N ^ R ^ S ^ M) ---------------------------------------
# N: how close (pixels) a person must be when the waste object first appears.
PROXIMITY_RADIUS=180.0
# S: max per-frame movement (pixels) still counted as "stationary".
STATIONARY_THRESHOLD=8.0
# S: how many consecutive stationary frames confirm the object is at rest.
STATIONARY_FRAMES=8
# M: how far (pixels) the person must move away for the event to fire.
LEAVE_DISTANCE=100.0
# Ignore tracks seen for fewer than this many frames (tracker warm-up noise).
MIN_TRACK_FRAMES=5
# Ignore waste boxes smaller than this area (pixels^2) as detector noise.
MIN_OBJECT_AREA=150.0
# Ignore objects born within this many pixels of the frame edge (artifacts).
EDGE_MARGIN=20.0
# Waste already visible within the first N frames is treated as pre-existing
# litter and never fires an event.
IGNORE_FIRST_FRAMES=20


# --- Track stitching / tracker recovery --------------------------------------
# If ByteTrack drops and re-assigns an ID, the engine re-links the new track to
# a recently lost one so it keeps its history (association, birth, stationary).
# Max gap (pixels) to reconnect a lost waste track.
WASTE_RECONNECT_DIST=60.0
# Max gap (frames) within which a lost waste track can reconnect.
WASTE_RECONNECT_WINDOW=30
# Max gap (pixels) to reconnect a lost person track.
PERSON_RECONNECT_DIST=80.0
# Max gap (frames) within which a lost person track can reconnect.
PERSON_RECONNECT_WINDOW=30
# How many frames a lost track is remembered before it is discarded.
TRACK_BUFFER=60


# --- Evidence clips ----------------------------------------------------------
# Milliseconds of footage kept before and after each detected incident.
CLIP_BEFORE_MS=2000
CLIP_AFTER_MS=3000
